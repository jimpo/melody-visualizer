<?xml version="1.0" encoding="UTF-8"?>
<interface>
	<object class="GtkFrame" id="toplevel">
		<property name="valign">start</property>
		<child>
			<object class="GtkGrid">
				<property name="column-spacing">10</property>
				<child>
					<object class="GtkLabel">
						<property name="label">Rate</property>
					</object>
					<packing>
						<property name="left_attach">0</property>
						<property name="top_attach">0</property>
					</packing>
				</child>
				<child>
					<object class="GtkScale" id="rate_scale">
						<property name="adjustment">rate_adjustment</property>
						<property name="value_pos">right</property>
						<property name="hexpand">True</property>
					</object>
					<packing>
						<property name="left_attach">1</property>
						<property name="top_attach">0</property>
					</packing>
				</child>
				<style>
					<class name="control-grid"/>
				</style>
			</object>
		</child>
		<child type="label">
			<object class="GtkLabel">
				<property name="label">Volume Normalizer</property>
			</object>
		</child>
	</object>
	<object class="GtkAdjustment" id="rate_adjustment">
		<property name="upper">1</property>
		<property name="step_increment">0.1</property>
		<property name="page_increment">1</property>
	</object>
</interface>