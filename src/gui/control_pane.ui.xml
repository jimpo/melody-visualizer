<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <!--
    The bodies of the stages whose controls do not vary with the config. The
    accordion around them is built in control_pane.rs, because the transform
    stages between these come from the configured chain.
  -->
  <object class="GtkBox" id="source_body">
    <property name="orientation">vertical</property>
    <property name="spacing">16</property>
    <style>
      <class name="stage-body"/>
    </style>
    <child>
      <object class="GtkBox" id="source_type_selection">
        <property name="spacing">10</property>
      </object>
    </child>
    <child>
      <object class="GtkTreeView" id="port_list">
        <child>
          <object class="GtkTreeViewColumn">
            <property name="title">Port</property>
            <child>
              <object class="GtkCellRendererText"/>
              <attributes>
                <attribute name="text">0</attribute>
              </attributes>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>

  <object class="GtkBox" id="spectrum_body">
    <property name="orientation">vertical</property>
    <style>
      <class name="stage-body"/>
    </style>
    <child>
      <object class="GtkLabel" id="spectrum_caption">
        <property name="xalign">0</property>
        <style>
          <class name="caption"/>
        </style>
      </object>
    </child>
  </object>

  <object class="GtkBox" id="spiral_body">
    <property name="orientation">vertical</property>
    <style>
      <class name="stage-body"/>
    </style>
    <child>
      <object class="GtkLabel">
        <property name="label">Lowest pitch</property>
        <property name="xalign">0</property>
        <style>
          <class name="control-label"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkScale" id="min_freq_scale">
      </object>
    </child>
    <child>
      <object class="GtkLabel">
        <property name="label">Highest pitch</property>
        <property name="xalign">0</property>
        <style>
          <class name="control-label"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkScale" id="max_freq_scale">
      </object>
    </child>
    <child>
      <object class="GtkLabel">
        <property name="label">Key</property>
        <property name="xalign">0</property>
        <style>
          <class name="control-label"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkScale" id="key_freq_scale">
      </object>
    </child>
  </object>
</interface>
