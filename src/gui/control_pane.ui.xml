<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="control_pane">
    <property name="name">control_pane</property>
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkListBox" id="control_menu">
        <property name="name">control_menu</property>
        <child>
          <object class="GtkListBoxRow" id="source_row">
            <style>
              <class name="stage-row"/>
            </style>
            <property name="child">
              <object class="GtkGrid">
                <property name="row_homogeneous">1</property>
                <property name="column_homogeneous">1</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Audio Source</property>
                    <style>
                      <class name="stage-name"/>
                    </style>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="source_name">
                    <style>
                      <class name="stage-summary"/>
                    </style>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkListBoxRow" id="spectrum_generator_row">
            <style>
              <class name="stage-row"/>
            </style>
            <property name="child">
              <object class="GtkGrid">
                <property name="row_homogeneous">1</property>
                <property name="column_homogeneous">1</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Spectrum Analysis</property>
                    <style>
                      <class name="stage-name"/>
                    </style>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="spectrum_generator_name">
                    <style>
                      <class name="stage-summary"/>
                    </style>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkListBoxRow" id="visualization_row">
            <style>
              <class name="stage-row"/>
            </style>
            <property name="child">
              <object class="GtkGrid">
                <property name="row_homogeneous">1</property>
                <property name="column_homogeneous">1</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Visualization</property>
                    <style>
                      <class name="stage-name"/>
                    </style>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="visualization_name">
                    <style>
                      <class name="stage-summary"/>
                    </style>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkStack" id="control_stack">
        <property name="name">control_stack</property>
        <style>
          <class name="stage-body"/>
        </style>
        <child>
          <object class="GtkFrame" id="source_control">
            <style>
              <class name="card"/>
            </style>
            <child type="label">
              <object class="GtkLabel">
                <property name="label">Audio Source</property>
              </object>
            </child>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkBox" id="source_type_selection">
                  </object>
                </child>
                <child>
                  <object class="GtkTreeView" id="port_list">
                    <child>
                      <object class="GtkTreeViewColumn">
                        <property name="title">Port</property>
                        <child>
                          <object class="GtkCellRendererText"/>
                          <attributes>
                            <attribute name="text">0</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkFrame" id="spectrum_generator_control">
            <style>
              <class name="card"/>
            </style>
            <child type="label">
              <object class="GtkLabel">
                <property name="label">Spectrum Analysis</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkFrame" id="visualization_control">
            <style>
              <class name="card"/>
            </style>
            <child type="label">
              <object class="GtkLabel">
                <property name="label">Visualization</property>
              </object>
            </child>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Lowest pitch</property>
                    <property name="xalign">0</property>
                    <style>
                      <class name="control-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkScale" id="min_freq_scale">
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Highest pitch</property>
                    <property name="xalign">0</property>
                    <style>
                      <class name="control-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkScale" id="max_freq_scale">
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Key</property>
                    <property name="xalign">0</property>
                    <style>
                      <class name="control-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkScale" id="key_freq_scale">
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
