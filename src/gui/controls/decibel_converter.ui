<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkGrid" id="toplevel">
    <property name="valign">start</property>
    <property name="column-spacing">10</property>
    <style>
      <class name="stage-body"/>
    </style>
    <child>
      <object class="GtkLabel">
        <property name="label">Min Level</property>
        <style>
          <class name="control-label"/>
        </style>
        <layout>
          <property name="column">0</property>
          <property name="row">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkScale" id="min_level_scale">
        <property name="draw-value">1</property>
        <property name="adjustment">min_level_adjustment</property>
        <property name="value_pos">right</property>
        <property name="hexpand">1</property>
        <layout>
          <property name="column">1</property>
          <property name="row">0</property>
        </layout>
      </object>
    </child>
  </object>
  <object class="GtkAdjustment" id="min_level_adjustment">
    <property name="lower">-10</property>
    <property name="upper">10</property>
    <property name="step_increment">1</property>
    <property name="page_increment">10</property>
  </object>
</interface>
