<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <!--
    The bodies of the stages whose controls do not vary with the config. The
    accordion around them is built in control_pane.rs, because the transform
    stages between these come from the configured chain.
  -->
  <object class="GtkBox" id="source_body">
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
    <style>
      <class name="stage-body"/>
    </style>
    <child>
      <object class="GtkBox" id="source_type_selection">
        <property name="spacing">10</property>
        <property name="margin-bottom">8</property>
      </object>
    </child>
    <child>
      <!--
        A boxed list of the ports the source can be fed from. The rows come
        from the controller's list model, bound in control_pane.rs.
      -->
      <object class="GtkListBox" id="port_list">
        <property name="selection-mode">single</property>
        <style>
          <class name="card"/>
          <class name="port-list"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkLabel">
        <property name="label">Ports refresh as JACK connects and drops them.</property>
        <property name="xalign">0</property>
        <style>
          <class name="caption"/>
        </style>
      </object>
    </child>
  </object>

  <object class="GtkBox" id="spectrum_body">
    <property name="orientation">vertical</property>
    <style>
      <class name="stage-body"/>
    </style>
    <child>
      <object class="GtkLabel" id="spectrum_caption">
        <property name="xalign">0</property>
        <style>
          <class name="caption"/>
        </style>
      </object>
    </child>
  </object>

  <object class="GtkBox" id="spiral_body">
    <property name="orientation">vertical</property>
    <style>
      <class name="stage-body"/>
    </style>
    <child>
      <object class="GtkLabel">
        <property name="label">Lowest pitch</property>
        <property name="xalign">0</property>
        <style>
          <class name="control-label"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkScale" id="min_freq_scale">
      </object>
    </child>
    <child>
      <object class="GtkLabel">
        <property name="label">Highest pitch</property>
        <property name="xalign">0</property>
        <style>
          <class name="control-label"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkScale" id="max_freq_scale">
      </object>
    </child>
  </object>
</interface>
