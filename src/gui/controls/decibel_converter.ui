<?xml version="1.0" encoding="UTF-8"?>
<interface>
	<object class="GtkFrame" id="toplevel">
		<property name="valign">start</property>
		<child>
			<object class="GtkGrid">
				<property name="column-spacing">10</property>
				<child>
					<object class="GtkLabel">
						<property name="label">Min Level</property>
					</object>
					<packing>
						<property name="left_attach">0</property>
						<property name="top_attach">0</property>
					</packing>
				</child>
				<child>
					<object class="GtkScale" id="min_level_scale">
						<property name="adjustment">min_level_adjustment</property>
						<property name="value_pos">right</property>
						<property name="hexpand">True</property>
					</object>
					<packing>
						<property name="left_attach">1</property>
						<property name="top_attach">0</property>
					</packing>
				</child>
				<style>
					<class name="control-grid"/>
				</style>
			</object>
		</child>
		<child type="label">
			<object class="GtkLabel">
				<property name="label">Decibel Converter</property>
			</object>
		</child>
	</object>
	<object class="GtkAdjustment" id="min_level_adjustment">
		<property name="lower">-10</property>
		<property name="upper">10</property>
		<property name="step_increment">1</property>
		<property name="page_increment">10</property>
	</object>
</interface>